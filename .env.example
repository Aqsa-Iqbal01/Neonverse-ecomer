# ---------------------------------------------------------------------------
# Neon / PostgreSQL
# ---------------------------------------------------------------------------
# Create a free database at https://neon.tech, copy the pooled connection string.
# It looks like: postgresql://user:password@ep-xxx-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth (JWT signing secret — generate with: openssl rand -base64 32)
# ---------------------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Optional: promote this email to admin on signup. If unset, the FIRST user
# who signs up automatically becomes the admin.
ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
# Secret key (sk_test_... for development)
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key (pk_test_...) — safe to expose in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret. Get it from Stripe Dashboard > Developers > Webhooks.
# For local dev, run: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# App URL — used to build Stripe success/cancel redirect URLs
# Local dev: http://localhost:3000
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
